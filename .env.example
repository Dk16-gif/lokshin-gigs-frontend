# Copy this file to .env and fill in your values
# Railway sets these automatically — only needed for local development

DATABASE_URL=        # Set by Railway automatically (leave blank locally)

# Local development (XAMPP) — only used if DATABASE_URL is not set
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=lokshin_gigs
DB_PORT=3306

# App settings
SESSION_SECRET=change_this_to_a_long_random_string
NODE_ENV=production
PORT=3000
